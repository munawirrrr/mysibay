ke-width='2'>\r\n        <rect x='2' y='4' width='20' height='16' rx='2'/>\r\n        <path d='m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7'/>\r\n      </svg>\r\n      <span style='font-size: 12px; color: rgba(255,255,255,0.92); font-weight: 500;'>Sibay@PenmadPidie.com</span>\r\n    </div>\r\n\r\n    <div style='margin-top: 14px;'>\r\n      <span style='display: inline-block; background: rgba(0,0,0,0.15); color: #ffffff; font-size: 11px; font-weight: 700; letter-spacing: 1px; padding: 4px 12px; border-radius: 20px; text-transform: uppercase;'>\r\n        Tahun \" . htmlspecialchars($tahun) . \"\r\n      </span>\r\n    </div>\r\n\r\n  </div>\r\n</div>\r\n\";"
